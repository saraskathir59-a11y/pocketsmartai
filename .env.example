# ---------------------------------------------------------------------------
# PocketSmart AI - environment configuration
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ---------------------------------------------------------------------------

# Google Gemini API key (get one at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here

# Alternative name also accepted by the app if GOOGLE_API_KEY is not set
# GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use. "gemini-flash-latest" is an alias that always points to
# Google's current flash model, so it won't break when a dated model name
# (e.g. gemini-1.5-flash, gemini-2.5-flash) gets retired. Override only if you
# need to pin a specific version.
GEMINI_MODEL=gemini-flash-latest

# Secret key used to sign JWT access tokens - use a long random string in production
SECRET_KEY=your_secret_key_here
